# Copie para .env e preencha. O .env nunca vai para o git.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=pagila
HERMES_SEMENTE=2026
HERMES_TAXA_ERRO=0.20
# Caminho do psql (no Windows: C:\Program Files\PostgreSQL\18\bin\psql.exe)
